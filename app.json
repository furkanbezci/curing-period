{
  "expo": {
    "name": "beton-kur-takip",
    "slug": "beton-kur-takip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skyforge.cureplan",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff",
        "versionCode": "1.0.0"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.skyforge.cureplan",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Numune fotoğrafları çekmek için kamera erişimi gerekir.",
          "photosPermission": "Galeriden fotoğraf seçmek için fotoğraflarınıza erişim gerekir."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Fotoğraflarınızı kullanmak için galeri erişimi gerekir.",
          "savePhotosPermission": "Çekilen fotoğrafları galerinize kaydetmek için izin gerekir."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8f464f19-f8cb-4ec4-b1be-4186a9d43b3b"
      }
    }
  }
}